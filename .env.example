NODE_ENV=development
PORT=3000

ADMIN_EMAIL=admin@localhost
# Obrigatório: escolha uma senha forte de pelo menos 12 caracteres.
ADMIN_PASSWORD=change-me-before-running

APINEX_BASE_URL=https://api.apinex.bond
APINEX_API_KEY=
APINEX_MODEL=free/gpt-6-luna
APINEX_MAX_TOKENS=2048

BERRY_SESSION_ID=default
BERRY_DATABASE_PATH=./data/berry.db
BERRY_AUTH_FOLDER=./data/auth
APP_DATABASE_PATH=./data/app.db
WHATSAPP_AUTO_CONNECT=false

AGENT_NAME=Atendente IA
BUSINESS_PROMPT=
MAX_HISTORY_MESSAGES=30
ALLOW_GROUPS=false

# Hosts exatos, separados por vírgula. Sem protocolo ou caminho.
ALLOWED_CTA_HOSTS=
# Mídias remotas exigem HTTPS, hosts autorizados e IP público.
# Vazio: utiliza ALLOWED_CTA_HOSTS. Limite 25 MiB, sem redirects.
ALLOWED_MEDIA_HOSTS=

# Somente habilite atrás de um proxy reverso confiável.
TRUST_PROXY=0
